{% extends 'base.html.twig' %}

{% block title %}Page index{% endblock %}


{% block body %}
<h1 class="text-center">{{ galerie.titre }}</h1>
  <div class="album py-5 bg-body-tertiary">
    <div class="container">
      <p class="lead mb-4">{{ galerie.description | raw }}</p>
      
      
      <h2>Les images</h2>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
        
        {% for image in galerie.images %}
        <div class="col">
          <div class="card shadow-sm">
            <img class="card-img-top" width="100%" height="225" src="{{ asset('uploads/images/' ~ image.url) }}" preserveAspectRatio="xMidYMid slice" focusable="false"><title>Placeholder</title><text x="50%" y="50%" fill="#eceeef" dy=".3em">{{image.legende | raw}}</text></svg>
            <div class="card-body">
              
              <div class="d-flex justify-content-between align-items-center">
                 
                {# <small class="btn btn-dark my-2">{{ galerie.date|date('Y-m-d H:i:s')  }}</small> #}
              </div>
            </div>
          </div>
        </div>
        {% else %}
            <tr>
                <td colspan="4">Pas d'images associées à cette galerie</td>
            </tr>
        {% endfor %}
      
    </div>
  </div>
        
  {% if is_granted('ROLE_ADMIN') %}
    <div class="mx-auto text-center">
      <a href="{{ path('admin_galerie') }}"><button type="button" class="col-1 btn btn-primary my-2">Gérer</button></a>
    </div>
  {% elseif is_granted('ROLE_USER')%}

  {% endif %}
{% endblock %}
